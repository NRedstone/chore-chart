rules_version = '2';

// FALLBACK RULES: only for use if the normal ones (firestore.rules) ever lock
// the owner out. Identical except that they don't check when the owner's
// session signed in, so "Sign out all other devices" stops cutting off the
// owner's other sessions. Everything else works the same.
//
// A household is reachable only by its owner (signed in with Google or a
// confirmed email) or by a device the owner linked with a one-time code.
// The old way in, a 6-letter household code alone, no longer works.
//
// The access records are NEVER writable from the app. Only the Cloud
// Functions change them.
service cloud.firestore {
  match /databases/{database}/documents {

    function accessPath(hid) { return /databases/$(database)/documents/access/$(hid); }

    // The owner, on a session that signed in at or after the last
    // "sign out other devices" (auth_time is when the session first signed in
    // and does not change as the session refreshes).
    function isOwner(hid) {
      return request.auth != null
        && exists(accessPath(hid))
        && get(accessPath(hid)).data.ownerUid == request.auth.uid;
    }

    // A device linked with a one-time code. Removing it from the list takes
    // effect on its very next request.
    function isLinkedDevice(hid) {
      return request.auth != null
        && exists(accessPath(hid))
        && request.auth.uid in get(accessPath(hid)).data.devices;
    }

    match /households/{hid} {
      allow read, write: if isOwner(hid) || isLinkedDevice(hid);
    }

    match /access/{hid} {
      allow get: if isOwner(hid) || isLinkedDevice(hid);
      allow list, write: if false;
    }

    // Lets a signed-in person find out which household they belong to.
    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Everything else (link codes, transfer codes, attempt counters) is
    // reachable only by the Cloud Functions.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
